{
	"name": "@earendil-works/pi-provider-host",
	"version": "0.84.1",
	"description": "Provider SDK execution boundary for the Rust Core",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./stdio": {
			"types": "./dist/stdio.d.ts",
			"import": "./dist/stdio.js"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"import": "./dist/runtime.js"
		}
	},
	"bin": {
		"pi-provider-host": "./dist/main.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"typecheck": "tsgo -p tsconfig.test.json",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"pi",
		"provider",
		"host"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/provider-host"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^0.84.1",
		"@earendil-works/pi-protocol": "^0.84.1",
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.9"
	}
}
